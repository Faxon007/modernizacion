{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Iniciar Backend (ASP.NET API)",
      "type": "shell",
      "command": "dotnet run",
      "options": {
        "cwd": "${workspaceFolder}/Backend"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Iniciar Frontend (Angular UI)",
      "type": "shell",
      "command": "npm run start",
      "options": {
        "cwd": "${workspaceFolder}/Frontend"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "Ejecutar Aplicación Completa (Backend + Frontend)",
      "dependsOn": [
        "Iniciar Backend (ASP.NET API)",
        "Iniciar Frontend (Angular UI)"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
