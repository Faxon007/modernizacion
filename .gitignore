# ====================================================================
# Gitignore maestro para CobroVisaEnLink (Monorreferencia Backend + Frontend)
# ====================================================================

# Directorios de Plantillas y Código Legacy (Opcional: omitir o mantener como referencia)
NeoLinkBackendPlantilla/
NeoLinkFrontEnd/
CobroVisaEnLink/ # Omitir carpeta legada WebForms (quitar si se desea versionar como respaldo)

# Archivos de configuración del sistema operativo y editores
.DS_Store
Thumbs.db
.idea/
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.zip

# ====================================================================
# BACKEND (C# .NET)
# ====================================================================
Backend/bin/
Backend/obj/
Backend/publish/
Backend/ApplicationData/Logs/*.txt
Backend/ApplicationData/db.cef2 # Archivo sensible de conexiones (no versionar credenciales de producción)

# ====================================================================
# FRONTEND (Angular / Node)
# ====================================================================
Frontend/node_modules/
Frontend/dist/
Frontend/tmp/
Frontend/.angular/
Frontend/src/environments/environment.production.ts # Opcional: si contiene llaves de producción reales


# ====================================================================
# ARCHIVOS GENERALES Y LOGS
# ====================================================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*


[Bb]in/
[Oo]bj/
*.exe
*.dll
